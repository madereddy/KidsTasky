# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server Port
PORT=3000
# Server bind host (secure default keeps app local-only)
HOST=127.0.0.1
# Comma-separated allowed browser origins for CORS/socket.io.
# For LAN access, include your device URL, e.g.:
# ALLOWED_ORIGINS=http://192.168.1.50:3000,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLite Database Path (default: database.db)
DB_PATH=database.db

# JWT Secret for Auth Authentication
JWT_SECRET=your_jwt_secret_here

# Gemini API Key for natural language features
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth setup (Optional, for Calendar integration)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/sync/callback/google

# Mailgun signing key for incoming webhooks validation
MAILGUN_SIGNING_KEY=your_mailgun_signing_key_here

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:admin@yourdomain.com

# Email fallback (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=KidsTasky <noreply@yourdomain.com>
