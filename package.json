{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "NODE_ENV=production node --import @opentelemetry/instrumentation/hook.mjs dist/server.js",
    "test": "vitest run",
    "dev": "node --import @opentelemetry/instrumentation/hook.mjs --import tsx/esm server.ts",
    "build": "vite build && pnpm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node24 --outfile=dist/server.js --format=esm --packages=external --loader:.sql=text && node --input-type=commonjs -e \"require('fs').cpSync('src/server/migrations','dist/migrations',{recursive:true})\"",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:e2e:verification": "node scripts/playwright-verification-workflow.mjs",
    "health:memory:sample": "node scripts/sample-health-memory.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.7.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@xmldom/xmldom": "^0.9.10",
    "argon2": "^0.44.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dav": "^1.8.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "googleapis": "^173.0.0",
    "helmet": "^8.2.0",
    "imap-simple": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.17.0",
    "mailparser": "^3.9.9",
    "motion": "^12.40.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "node-ical": "^0.26.1",
    "nodemailer": "^8.0.10",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "semver": "^7.8.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/imap-simple": "^4.2.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "ws": "^8.21.0",
    "qs": "^6.15.2",
    "protobufjs": "^7.6.1",
    "@protobufjs/utf8": "^1.1.1",
    "nodemailer": "^8.0.9",
    "utf7": {
      "semver": "^7.8.1"
    }
  }
}
